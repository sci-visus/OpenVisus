<dataset typename='IdxMultipleDataset'>

	<dataset url='file://./A/visus.idx' name= '0'  />
	<dataset url='file://./B/visus.idx' name= '1'  />
	<dataset url='file://./C/visus.idx' name= '2'  />
	<dataset url='file://./D/visus.idx' name= '3'  />

	<field name="example" > 			
		<code>
		<![CDATA[  
import numpy as np
PrintLine("FILE",0,0,f"# query_time={query_time}")
t=int(query_time)
tmp=input[f"{t}"]['temperature?time=0']

# cast to float32
target_dtype = DType.fromString(f"float32[{tmp.dtype.ncomponents()}]")
if tmp.dtype != target_dtype:
	tmp = ArrayUtils.cast(tmp, target_dtype)

output=tmp    
		]]>
		</code>
	</field> 

